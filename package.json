{
  "name": "pilates-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "create-admin": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' ts-node prisma/create-admin.ts",
    "db:up": "docker compose up -d",
    "db:push": "prisma db push",
    "db:seed": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' ts-node prisma/seed.ts",
    "db:generate": "prisma generate",
    "setup": "npm run db:up && npm run db:push && npm run db:generate"
  },
  "prisma": {
    "seed": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' ts-node prisma/seed.ts"
  },
