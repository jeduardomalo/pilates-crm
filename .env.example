# Copy to .env and fill in. Use connect_timeout=5 to avoid hanging if DB is down.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?connect_timeout=5"

# Required for login / SessionProvider
NEXTAUTH_SECRET="your-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google Calendar (Schedule page – see docs/SETUP-GOOGLE-CALENDAR.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/auth/callback
# GOOGLE_TOKEN_SECRET=  # optional; app will fall back to NEXTAUTH_SECRET
